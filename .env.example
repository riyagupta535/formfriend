GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=minimal
# Valid Gemini responses are cached locally for one hour to avoid duplicate API calls.
GEMINI_CACHE_TTL_SECONDS=3600
# Optional override; defaults to backend/.cache/gemini-responses.sqlite3.
# GEMINI_CACHE_PATH=/absolute/path/to/gemini-responses.sqlite3
# Without GEMINI_API_KEY, the backend uses labeled mock questions.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side ElevenLabs credentials; required for /voice-demo playback.
# Used for read-aloud on /questions and /voice-demo; independent of StepFun.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional bearer secret for /agent/* tool endpoints (server-side only):
AGENT_TOOL_SECRET=
# ElevenLabs agent that guides the question conversation (create with backend/scripts/setup_elevenlabs_agent.py).
ELEVENLABS_AGENT_ID=
# LLM the agent reasons with (set in ElevenLabs, not called by our backend). Rerun the setup script with --update after changing.
ELEVENLABS_AGENT_LLM=gemini-2.5-flash
