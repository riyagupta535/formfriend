STEP_API_KEY=
STEP_BASE_URL=https://api.stepfun.ai/v1
STEP_MODEL=step-5-preview
# Without STEP_API_KEY, the backend uses labeled mock questions.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side ElevenLabs credentials; required for /voice-demo playback.
# Used for read-aloud on /questions and /voice-demo; independent of StepFun.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional bearer secret for /agent/* tool endpoints (server-side only):
AGENT_TOOL_SECRET=
# ElevenLabs agent that guides the question conversation (create with backend/scripts/setup_elevenlabs_agent.py).
ELEVENLABS_AGENT_ID=
# LLM the agent reasons with (set in ElevenLabs, not called by our backend). Rerun the setup script with --update after changing.
ELEVENLABS_AGENT_LLM=gemini-2.5-flash
